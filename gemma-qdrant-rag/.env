LLM_PROVIDER=ollama
LLM_MODEL=gemma:2b

# For local testing without Docker, uncomment the line below:
# QDRANT_PATH=./qdrant_data
# For Docker usage, use the lines below:
QDRANT_HOST=localhost
QDRANT_PORT=6333

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
QDRANT_COLLECTION=local_rag

# Orchestrator-specific overrides
LLM_BASE_URL=http://llm-service:11434

# Note: service-only variables were moved to .env.services to avoid polluting the Orchestrator environment (pydantic forbids unknown keys).
INGESTION_HOST=localhost
INGESTION_PORT=8010
