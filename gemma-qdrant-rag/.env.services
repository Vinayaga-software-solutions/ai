# Service-specific env vars for skeleton services (used only by non-orchestrator containers)

# Internal Docker network names and ports
INGESTION_HOST=ingestion
INGESTION_PORT=80

CHUNKING_HOST=chunking
CHUNKING_PORT=80

RETRIEVAL_HOST=retrieval
RETRIEVAL_PORT=80

AUTH_HOST=auth
AUTH_PORT=80

GATEWAY_HOST=gateway
GATEWAY_PORT=80

EMBEDDING_SERVICE_HOST=embedding-service
EMBEDDING_SERVICE_PORT=80
EMBEDDING_API_URL=http://embedding-service:80/embed

LLM_SERVICE_HOST=llm-service
LLM_SERVICE_PORT=11434

# Seeder state volume path (shared between seeder and the smoke test)
SEEDER_STATE_PATH=/state

# Smoke test tuning (optional override)
SMOKE_TIMEOUT=120
SMOKE_INTERVAL=2
