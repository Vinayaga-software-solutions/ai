# LLM Configuration
# Set to 'ollama' for local usage or 'openai_compatible' for cloud providers like Groq/Together/Vertex
LLM_PROVIDER=ollama
LLM_MODEL=gemma:2b
# Required if using openai_compatible
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1

# Vector DB Configuration
# Set QDRANT_PATH for local file storage, or HOST/PORT/API_KEY for server/cloud
# QDRANT_PATH=./qdrant_data
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=local_rag

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Document Storage (ingest-cli)
# Use 'local' for dev (saves to folder) or 'gcs' for prod (saves to GCS bucket)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/documents
# For prod with GCS:
# STORAGE_BACKEND=gcs
# GCS_BUCKET_NAME=your-bucket-name
# GCS_CREDENTIALS_PATH=/path/to/service-account.json
